@model IEnumerable<ComputerLaboratoryUsageMonitoringSystem.Models.LaboratorySession>

@{
    ViewData["Title"] = "Laboratory Monitoring";
}

<div class="container py-4">

    ```
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="fw-bold mb-0">Laboratory Monitoring</h2>
            </div>

            <p class="text-muted mb-0">
                Monitor and manage laboratory computer sessions.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-3">
            <span class="me-1">+</span>
            Register Session
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-10">
                        <label for="search" class="form-label fw-semibold">
                            Search Sessions
                        </label>

                        <div class="input-group">
                            <input type="text"
                                   id="search"
                                   name="search"
                                   value="@Context.Request.Query["search"]"
                                   class="form-control"
                                   placeholder="Search by student, course, computer, status..." />
                        </div>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div>
                <h5 class="fw-bold mb-1">Laboratory Sessions</h5>

                <small class="text-muted">
                    Current and previous laboratory usage records
                </small>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5 px-3">
                    <h5 class="fw-bold">
                        No laboratory sessions found
                    </h5>

                    <p class="text-muted">
                        There are currently no sessions matching your search.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Register First Session
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Session</th>
                                <th>Student</th>
                                <th>Course</th>
                                <th>Computer</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <span class="fw-semibold">
                                            #@item.SessionNumber
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.FirstName @item.LastName
                                        </div>

                                        <small class="text-muted">
                                            @item.StudentNumber
                                        </small>
                                    </td>

                                    <td>
                                        @item.Course
                                    </td>

                                    <td>
                                        <span class="computer-number">
                                            PC @item.ComputerNumber
                                        </span>
                                    </td>

                                    <td>
                                        @item.TimeIn.ToString("MMM dd, yyyy")

                                        <small class="d-block text-muted">
                                            @item.TimeIn.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                        @if (item.TimeOut.HasValue)
                                        {
                                            @item.TimeOut.Value.ToString("MMM dd, yyyy")

                                            <small class="d-block text-muted">
                                                @item.TimeOut.Value.ToString("hh:mm tt")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status == "Using")
                                        {
                                            <span class="badge status-using">
                                                ● Using
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge status-finished">
                                                ✓ Finished
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (item.Status == "Using")
                                            {
                                                <a asp-action="TimeOut"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-success">
                                                    Time Out
                                                </a>
                                            }

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure you want to delete this laboratory session?');">
                                                    Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
    ```

</div>
