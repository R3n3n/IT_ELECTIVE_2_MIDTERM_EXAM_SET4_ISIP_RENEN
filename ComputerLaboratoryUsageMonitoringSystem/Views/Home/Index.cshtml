@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->

<div class="container">

    <div class="row align-items-center py-5">

        <!-- LEFT SIDE -->

        <div class="col-lg-7">

            <div class="mb-3">

                <span class="badge bg-primary-subtle text-primary px-3 py-2">
                    Computer Laboratory System
                </span>

            </div>

            <h1 class="display-4 fw-bold mb-3">

                Computer Laboratory
                <span class="text-primary">
                    Usage Monitoring
                </span>

            </h1>

            <p class="lead text-secondary mb-4">

                A simple and organized way to register,
                monitor, and manage computer laboratory
                sessions.

            </p>


            <!-- ACTION BUTTONS -->

            <div class="d-flex flex-wrap gap-2">

                @if (User.Identity != null &&
                                User.Identity.IsAuthenticated)
                {
                    <a asp-controller="LaboratorySession"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">

                        Go to Monitoring

                    </a>

                    <a asp-controller="LaboratorySession"
                       asp-action="Create"
                       class="btn btn-outline-primary btn-lg px-4">

                        Register Session

                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary btn-lg px-4">

                        Login

                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-outline-primary btn-lg px-4">

                        Create Account

                    </a>
                }

            </div>

        </div>


        <!-- RIGHT SIDE -->

        <div class="col-lg-5 mt-5 mt-lg-0">

            <div class="home-system-card">

                <div class="system-card-icon">
                    🖥️
                </div>

                <h4 class="fw-bold mt-3">
                    Laboratory Monitoring
                </h4>

                <p class="text-secondary mb-4">

                    Keep track of laboratory computer
                    sessions from registration to time out.

                </p>


                <div class="system-feature">

                    <span class="feature-icon">
                        📝
                    </span>

                    <div>
                        <strong>
                            Session Registration
                        </strong>

                        <small class="d-block text-muted">
                            Record student laboratory usage.
                        </small>
                    </div>

                </div>


                <div class="system-feature">

                    <span class="feature-icon">
                        📊
                    </span>

                    <div>
                        <strong>
                            Usage Monitoring
                        </strong>

                        <small class="d-block text-muted">
                            View and manage laboratory sessions.
                        </small>
                    </div>

                </div>


                <div class="system-feature">

                    <span class="feature-icon">
                        🕐
                    </span>

                    <div>
                        <strong>
                            Time Out Recording
                        </strong>

                        <small class="d-block text-muted">
                            Record when a session is completed.
                        </small>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FEATURES -->

    <div class="row g-4 mt-3 mb-5">

        <!-- CARD 1 -->

        <div class="col-md-4">

            <div class="card h-100 p-3">

                <div class="card-body">

                    <div class="feature-card-icon mb-3">
                        📝
                    </div>

                    <h5 class="fw-bold">
                        Register Sessions
                    </h5>

                    <p class="text-muted mb-0">

                        Register students and record
                        their assigned laboratory computer,
                        purpose, and time in.

                    </p>

                </div>

            </div>

        </div>


        <!-- CARD 2 -->

        <div class="col-md-4">

            <div class="card h-100 p-3">

                <div class="card-body">

                    <div class="feature-card-icon mb-3">
                        🔎
                    </div>

                    <h5 class="fw-bold">
                        Monitor Usage
                    </h5>

                    <p class="text-muted mb-0">

                        Search and view laboratory sessions
                        while keeping track of their current
                        status.

                    </p>

                </div>

            </div>

        </div>


        <!-- CARD 3 -->

        <div class="col-md-4">

            <div class="card h-100 p-3">

                <div class="card-body">

                    <div class="feature-card-icon mb-3">
                        ✅
                    </div>

                    <h5 class="fw-bold">
                        Record Time Out
                    </h5>

                    <p class="text-muted mb-0">

                        Record the end of a laboratory session
                        and mark completed usage accordingly.

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>